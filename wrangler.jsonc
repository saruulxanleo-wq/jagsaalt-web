{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jagsaalt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": { "SITE_URL": "https://jagsaalt.saruulxanleo.workers.dev" }
  // SITE_URL: домэйн авсны дараа https://jagsaalt.mn болгож солино.
  // Нууц түлхүүрүүд: wrangler secret put SUPABASE_SECRET_KEY / WESEND_API_KEY
  // эсвэл Cloudflare dashboard → Worker → Settings → Variables and Secrets
}
